<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bpmn.BPMNViewerTemplate">
        <div class="bpmn-viewer-widget">
            <!-- Error display -->
            <div t-if="state.error" class="alert alert-danger" role="alert">
                <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
            </div>
            
            <!-- Success message -->
            <div t-if="state.lastMessage and !state.error" class="alert alert-success" role="alert">
                <i class="fa fa-check"/> <t t-esc="state.lastMessage"/>
            </div>
            
            <!-- Load button -->
            <div class="mb-3">
                <button type="button" 
                        class="btn btn-primary" 
                        t-on-click="onLoadDiagram"
                        t-att-disabled="state.loading">
                    <i t-if="state.loading" class="fa fa-spinner fa-spin"/>
                    <i t-else="" class="fa fa-refresh"/>
                    <t t-if="state.loading"> Loading...</t>
                    <t t-else=""> Load Diagram</t>
                </button>
            </div>
            
            <!-- BPMN Container -->
            <div t-ref="bpmnContainer" 
                 class="bpmn-viewer-container" 
                 style="height: 500px; border: 1px solid #dee2e6; background: #fafafa;">
                <div t-if="!state.loading" 
                     style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6c757d;">
                    <div class="text-center">
                        <i class="fa fa-sitemap fa-3x mb-3"/>
                        <div>BPMN Diagram</div>
                        <small>Click "Load Diagram" to render the diagram from XML</small>
                    </div>
                </div>
                <div t-if="state.loading" 
                     style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6c757d;">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-3x mb-3"/>
                        <div>Loading BPMN Diagram...</div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
