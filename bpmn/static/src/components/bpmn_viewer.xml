<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bpmn.BPMNViewer">
        <div class="bpmn-viewer-container" style="width: 100%;">
            <div t-ref="bpmnContainer" 
                 class="bpmn-canvas" 
                 t-att-style="'height: ' + height + '; border: 1px solid #dee2e6; background: #fafafa;'"/>
        </div>
    </t>

    <t t-name="bpmn.BPMNWidget" owl="1">
        <div class="bpmn-field-widget">
            <div t-ref="bpmnContainer" 
                 class="bpmn-canvas" 
                 style="height: 400px; width: 100%; border: 1px solid #dee2e6; background: #fafafa;">
                <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6c757d;">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-2x mb-2"/>
                        <div>Loading BPMN viewer...</div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
