<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bpmn_process_tree" model="ir.ui.view">
        <field name="name">bpmn.process.tree</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bpmn_process_form" model="ir.ui.view">
        <field name="name">bpmn.process.form</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Process Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <!-- BPMN Component Integration -->
                    <div style="margin: 20px 0;">
                        <div id="bpmn-owl-mount-point" data-unique-viewer="true">
                            <!-- BPMN component will be auto-mounted here -->
                        </div>
                    </div>
                    
                    <!-- BPMN XML Editor -->
                    <div style="margin-top: 30px;">
                        <div class="o_horizontal_separator">BPMN XML Source Code</div>
                        <div style="background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px; margin-top: 10px;">
                            <div style="background: #e9ecef; padding: 5px 10px; margin: -10px -10px 10px -10px; border-radius: 3px 3px 0 0; font-size: 12px; color: #6c757d;">
                                <i class="fa fa-code"/> XML Editor - Edit your BPMN 2.0 definition below
                            </div>
                            <field name="bpmn_xml" widget="text" nolabel="1" 
                                   style="min-height: 300px; font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace; 
                                          background: #ffffff; border: 1px solid #ced4da; border-radius: 3px; 
                                          padding: 10px; font-size: 13px; line-height: 1.4;" 
                                   placeholder="Enter your BPMN 2.0 XML definition here..."/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bpmn_process_search" model="ir.ui.view">
        <field name="name">bpmn.process.search</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bpmn_process" model="ir.actions.act_window">
        <field name="name">BPMN Processes</field>
        <field name="res_model">bpmn.process</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bpmn_process_tree"/>
        <field name="search_view_id" ref="view_bpmn_process_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BPMN process!
            </p>
            <p>
                Use this module to create and view BPMN process diagrams.
                You can create new processes or import existing BPMN XML definitions.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bpmn_root" 
              name="BPMN" 
              sequence="10"/>
    
    <menuitem id="menu_bpmn_processes" 
              name="Processes" 
              parent="menu_bpmn_root" 
              action="action_bpmn_process" 
              sequence="10"/>
</odoo>
