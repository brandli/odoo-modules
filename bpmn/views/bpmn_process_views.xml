<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bpmn_process_tree" model="ir.ui.view">
        <field name="name">bpmn.process.tree</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bpmn_process_form" model="ir.ui.view">
        <field name="name">bpmn.process.form</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Process Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="BPMN Diagram" name="diagram">
                            <div style="margin: 10px 0;">
                                <div class="alert alert-info">
                                    <strong>BPMN XML Source:</strong> Edit the BPMN process definition below, then load the diagram.
                                </div>
                                <field name="bpmn_xml" widget="text" nolabel="1" style="min-height: 300px; font-family: monospace;"/>
                                
                                <!-- Fallback button (always present) -->
                                <div style="margin: 20px 0;">
                                    <div class="btn btn-primary bpmn-load-button" style="cursor: pointer; display: inline-block;" onclick="window.loadBPMNDiagram(event)">
                                        <i class="fa fa-refresh"/> Load Diagram
                                    </div>
                                </div>
                                
                                <!-- Container that will be managed by OWL component -->
                                <div id="bpmn-owl-mount-point" style="margin: 20px 0;">
                                    <!-- OWL component will mount here and may add its own button -->
                                </div>
                                
                                <!-- Fallback container (if OWL mounting fails) -->
                                <div id="bpmn-display-container" style="height: 500px; border: 1px solid #dee2e6; background: #fafafa;">
                                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6c757d;">
                                        <div class="text-center">
                                            <i class="fa fa-sitemap fa-3x mb-3"/>
                                            <div>BPMN Diagram</div>
                                            <small>Click "Load Diagram" to render the diagram from XML above</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bpmn_process_search" model="ir.ui.view">
        <field name="name">bpmn.process.search</field>
        <field name="model">bpmn.process</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bpmn_process" model="ir.actions.act_window">
        <field name="name">BPMN Processes</field>
        <field name="res_model">bpmn.process</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bpmn_process_tree"/>
        <field name="search_view_id" ref="view_bpmn_process_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BPMN process!
            </p>
            <p>
                Use this module to create and view BPMN process diagrams.
                You can create new processes or import existing BPMN XML definitions.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bpmn_root" 
              name="BPMN" 
              sequence="10"/>
    
    <menuitem id="menu_bpmn_processes" 
              name="Processes" 
              parent="menu_bpmn_root" 
              action="action_bpmn_process" 
              sequence="10"/>
</odoo>
