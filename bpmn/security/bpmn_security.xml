<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access rights for BPMN Process Version model -->
    <record id="access_bpmn_process_version_user" model="ir.model.access">
        <field name="name">bpmn.process.version user</field>
        <field name="model_id" ref="model_bpmn_process_version"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="access_bpmn_process_version_manager" model="ir.model.access">
        <field name="name">bpmn.process.version manager</field>
        <field name="model_id" ref="model_bpmn_process_version"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>
