<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_simple_task_tree" model="ir.ui.view">
        <field name="name">simple.task.list</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_simple_task_form" model="ir.ui.view">
        <field name="name">simple.task.form</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_simple_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">simple.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_simple_task_root" 
              name="Simple Task"
              action="action_simple_task"
              sequence="10"/>
    <menuitem id="menu_simple_task" 
              name="Tasks" 
              parent="menu_simple_task_root" 
              action="action_simple_task" 
              sequence="10"/>
</odoo>
